{
  "name": "seo-audit-tool",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  "build": {
    "command": "node scripts/build.mjs"
  },
  "assets": {
    "directory": "./public"
  },
  "vars": {
    // Max domains per audit. Free plan allows 50 subrequests/request; raise on a paid plan.
    "MAX_DOMAINS": "5"
  },
  "observability": { "enabled": true }
}
